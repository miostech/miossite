# ==========================================================================
# Mios Tech - Exemplo de variaveis de ambiente
# Copie para .env.local e preencha os valores.
# ==========================================================================

# --- Resend (newsletter, notificacao de blog e leads do portfolio) ---
# Chave da API do Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# ID da audiencia do Resend (https://resend.com/audiences)
# Usada para inscritos da newsletter e contatos do portfolio.
RESEND_AUDIENCE_ID=

# Remetente verificado no Resend (ex.: "Mios Tech <hello@miostec.com>")
# Usado nos e-mails da newsletter e na notificacao de leads do portfolio.
NEWSLETTER_FROM=

# --- Leads do portfolio ---
# Para onde enviar os leads capturados no gate do portfolio.
# Se vazio, usa CONTACT_TO e, por fim, hello@miostec.com.
PORTFOLIO_LEADS_TO=

# E-mail de contato geral (fallback para os leads do portfolio).
CONTACT_TO=

# --- Banco de dados (area de cobrancas) ---
# Connection string do Postgres (Supabase). Use o pooler (Supavisor, porta 6543)
# para funcoes serverless. Ex.: postgres://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# --- Stripe (area de cobrancas) ---
# Use chaves de TESTE (sk_test_... / pk_test_...) em desenvolvimento.
# As chaves live (sk_live_...) ficam so na Vercel, em producao.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Segredo do endpoint de webhook (whsec_...), gerado no painel do Stripe.
STRIPE_WEBHOOK_SECRET=

# --- Geral ---
# URL publica do site (usada pelo script de notificacao de novos posts).
SITE_URL=https://www.mios.pt
CRON_SECRET
